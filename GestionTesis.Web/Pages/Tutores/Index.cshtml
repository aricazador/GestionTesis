@page
@model GestionTesis.Web.Pages.Tutores.IndexModel
@{
    ViewData["Title"] = "Tutores";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="text-magenta mb-0"><i class="bi bi-person-badge"></i> Tutores</h3>
    @if (Model.EsAdmin)
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrear" data-nuevo="#formCrear">
            <i class="bi bi-plus-circle"></i> Nuevo tutor
        </button>
    }
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-magenta align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Especialidad</th>
                    <th>Correo</th>
                    <th class="text-center">Tesis</th>
                    @if (Model.EsAdmin) { <th class="text-end">Acciones</th> }
                </tr>
            </thead>
            <tbody>
                @if (Model.Tutores.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay tutores registrados.</td></tr>
                }
                @foreach (var t in Model.Tutores)
                {
                    var lleno = t.CantidadTesis >= Reglas.MaximoTesisPorTutor;
                    var valores = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
                    {
                        ["EdicionId"] = t.Id.ToString(),
                        ["Edicion.Nombre"] = t.Nombre,
                        ["Edicion.Especialidad"] = t.Especialidad,
                        ["Edicion.Correo"] = t.Correo
                    });
                    <tr>
                        <td class="fw-semibold">@t.Nombre</td>
                        <td>@t.Especialidad</td>
                        <td><a href="mailto:@t.Correo">@t.Correo</a></td>
                        <td class="text-center">
                            <span class="badge @(lleno ? "bg-danger" : "bg-magenta")">@t.CantidadTesis / @Reglas.MaximoTesisPorTutor</span>
                        </td>
                        @if (Model.EsAdmin)
                        {
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalEditar"
                                        data-editar="#formEditar" data-valores="@valores">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Eliminar" asp-route-id="@t.Id" class="d-inline"
                                      data-confirmar="¿Eliminar al tutor «@t.Nombre»?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.EsAdmin)
{
    <!-- MODAL CREAR -->
    <div class="modal fade" id="modalCrear" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Crear" id="formCrear" class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-plus-circle"></i> Nuevo tutor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.Nombre" class="form-label">Nombre</label>
                        <input asp-for="Nuevo.Nombre" class="form-control" placeholder="Ing. Juan Pérez" />
                        <span asp-validation-for="Nuevo.Nombre"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.Especialidad" class="form-label">Especialidad</label>
                        <input asp-for="Nuevo.Especialidad" class="form-control" list="especialidades" />
                        <span asp-validation-for="Nuevo.Especialidad"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.Correo" class="form-label">Correo</label>
                        <input asp-for="Nuevo.Correo" class="form-control" placeholder="nombre@upds.edu.bo" />
                        <span asp-validation-for="Nuevo.Correo"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL EDITAR -->
    <div class="modal fade" id="modalEditar" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Editar" id="formEditar" class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-pencil"></i> Editar tutor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EdicionId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <div class="mb-3">
                        <label asp-for="Edicion.Nombre" class="form-label">Nombre</label>
                        <input asp-for="Edicion.Nombre" class="form-control" />
                        <span asp-validation-for="Edicion.Nombre"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Edicion.Especialidad" class="form-label">Especialidad</label>
                        <input asp-for="Edicion.Especialidad" class="form-control" list="especialidades" />
                        <span asp-validation-for="Edicion.Especialidad"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Edicion.Correo" class="form-label">Correo</label>
                        <input asp-for="Edicion.Correo" class="form-control" />
                        <span asp-validation-for="Edicion.Correo"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

    <datalist id="especialidades">
        <option value="Ingeniería de Software" /><option value="Bases de Datos" /><option value="Redes y Telecomunicaciones" />
        <option value="Inteligencia Artificial" /><option value="Seguridad Informática" /><option value="Sistemas de Información" />
    </datalist>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
