@{
    var usuario = Context.Session.GetString(SesionClaves.Usuario);
    var rol = Context.Session.GetString(SesionClaves.Rol);
    var esAdmin = rol == Roles.Administrador;
    var rutaActual = Context.Request.Path.Value ?? "/";
    string Activo(string inicio) =>
        (inicio == "/" ? rutaActual == "/" || rutaActual.Equals("/Index", StringComparison.OrdinalIgnoreCase)
                       : rutaActual.StartsWith(inicio, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestión de Tesis</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" data-abrir-modal="@ViewData["AbrirModal"]">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-magenta shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/"><i class="bi bi-mortarboard-fill me-1"></i> Gestión de Tesis</a>
            @if (usuario is not null)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @Activo("/")" asp-page="/Index"><i class="bi bi-house"></i> Inicio</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/Tutores")" asp-page="/Tutores/Index"><i class="bi bi-person-badge"></i> Tutores</a></li>
                        <li class="nav-item"><a class="nav-link @Activo("/Tesis")" asp-page="/Tesis/Index"><i class="bi bi-journal-bookmark"></i> Tesis</a></li>
                        @if (esAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @Activo("/Usuarios")" asp-page="/Usuarios/Index"><i class="bi bi-people"></i> Usuarios</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 text-white">
                        <span><i class="bi bi-person-circle"></i> @usuario</span>
                        <span class="badge @(esAdmin ? "bg-warning text-dark" : "bg-light text-dark")">@rol</span>
                        <form method="post" asp-page="/Logout" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i> Salir</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @if (TempData["Exito"] is string exito)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-1"></i> @exito
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer-magenta text-center py-3 mt-auto">
        <small>UPDS · Ingeniería de Sistemas · Tarija @DateTime.Now.Year</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
