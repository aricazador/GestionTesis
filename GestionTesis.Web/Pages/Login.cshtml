@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="card shadow login-card mx-auto mt-4">
    <div class="card-header card-header-magenta text-center py-3">
        <h4 class="mb-0"><i class="bi bi-mortarboard-fill"></i> Iniciar sesión</h4>
    </div>
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Entrada.NombreUsuario" class="form-label">Usuario</label>
                <input asp-for="Entrada.NombreUsuario" class="form-control" autofocus />
                <span asp-validation-for="Entrada.NombreUsuario"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Entrada.Password" class="form-label">Contraseña</label>
                <input asp-for="Entrada.Password" class="form-control" />
                <span asp-validation-for="Entrada.Password"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Entrar</button>
        </form>
        <hr />
        <p class="text-center mb-0">¿No tenés cuenta? <a asp-page="/Registrar">Registrate</a></p>
        <p class="text-center text-muted small mt-2 mb-0">Prueba: <b>admin / 123456</b> (Administrador) · <b>usuario / 123456</b> (solo ver)</p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
