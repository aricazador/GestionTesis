@page
@model RegistrarModel
@{
    ViewData["Title"] = "Registrarse";
}
<div class="card shadow login-card mx-auto mt-4">
    <div class="card-header card-header-magenta text-center py-3">
        <h4 class="mb-0"><i class="bi bi-person-plus"></i> Crear cuenta</h4>
    </div>
    <div class="card-body p-4">
        <p class="text-muted small">Las cuentas nuevas quedan con rol <b>Usuario</b> (solo pueden ver). Los administradores los crea otro administrador.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Entrada.NombreUsuario" class="form-label">Usuario</label>
                <input asp-for="Entrada.NombreUsuario" class="form-control" />
                <span asp-validation-for="Entrada.NombreUsuario"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Entrada.Password" class="form-label">Contraseña</label>
                <input asp-for="Entrada.Password" class="form-control" />
                <span asp-validation-for="Entrada.Password"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Entrada.ConfirmarPassword" class="form-label">Confirmar contraseña</label>
                <input asp-for="Entrada.ConfirmarPassword" class="form-control" />
                <span asp-validation-for="Entrada.ConfirmarPassword"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2-circle"></i> Registrarme</button>
        </form>
        <hr />
        <p class="text-center mb-0"><a asp-page="/Login">Volver al login</a></p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
